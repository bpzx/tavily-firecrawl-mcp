# Tavily API key — primary fetch + search provider. Get one at https://tavily.com
TAVILY_API_KEY=

# Firecrawl API key — fallback fetch/search provider. Get one at https://firecrawl.dev
FIRECRAWL_API_KEY=

# Optional outbound proxy for the provider APIs (e.g. when they are unreachable
# directly from your network). Example: http://127.0.0.1:7890
# If unset, httpx still honors HTTP_PROXY / HTTPS_PROXY / ALL_PROXY.
WEB_FETCH_PROXY=

# Optional self-hosted / proxied endpoint overrides (trailing "/" is stripped).
# FIRECRAWL_BASE_URL=https://firecrawl.internal.example.com
# TAVILY_BASE_URL=https://tavily-proxy.internal.example.com

# Log level for stderr diagnostics (DEBUG / INFO / WARNING / ...; default INFO).
# LOG_LEVEL=INFO
